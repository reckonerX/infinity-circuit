---
layout: layouts/base.njk
---
<article class="post-article">
  <section class="hero" style="padding: 3rem 0 2.5rem;">
    <div class="container">
      <div style="margin-bottom: 1rem;">
        <a href="/news/" style="color: var(--void-violet); font-size: 0.875rem;">← Back to News</a>
      </div>
      {% if heroImage %}
      <div class="post-hero-image">
        <img src="{{ heroImage }}" alt="{{ title }}">
      </div>
      {% endif %}
      <h1 class="hero-title" style="font-size: 2rem;">{{ title }}</h1>
      <p class="hero-subtitle">{{ date | dateDisplay }}</p>
    </div>
  </section>
  <section class="section section-light">
    <div class="container" style="max-width: 780px;">
      <div class="post-body">
        {{ content | safe }}
      </div>
    </div>
  </section>
</article>

<style>
.post-hero-image {
  max-width: 780px;
  margin: 0 auto 2rem;
  border-radius: 6px;
  overflow: hidden;
}
.post-hero-image img {
  width: 100%;
  height: auto;
}
.post-body {
  color: rgba(255,255,255,0.78);
  font-size: 0.9375rem;
  line-height: 1.8;
}
.post-body h2 {
  font-size: 1.25rem;
  font-weight: 600;
  color: #fff;
  margin: 2rem 0 0.75rem;
}
.post-body h3 {
  font-size: 1rem;
  font-weight: 600;
  color: var(--void-violet);
  margin: 1.5rem 0 0.5rem;
}
.post-body p {
  margin-bottom: 1rem;
}
.post-body strong {
  color: #fff;
  font-weight: 500;
}
.post-body a {
  color: var(--void-violet);
  text-decoration: underline;
  text-underline-offset: 2px;
}
.post-body a:hover { color: #fff; }
.post-body img {
  max-width: 100%;
  border-radius: 6px;
  margin: 1.5rem 0;
}
.post-body ul, .post-body ol {
  padding-left: 1.5rem;
  margin-bottom: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}
</style>