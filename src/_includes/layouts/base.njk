<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description or 'Infinity Circuit — Marvel: Crisis Protocol Regional Competitive Circuit' }}">
  <title>{{ title + ' — Infinity Circuit' if title else 'Infinity Circuit' }}</title>
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="icon" type="image/svg+xml" href="/assets/images/mark.svg">
  <meta property="og:title" content="{{ title + ' — Infinity Circuit' if title else 'Infinity Circuit' }}">
  <meta property="og:description" content="{{ description or 'The Infinity Circuit is a regional Marvel: Crisis Protocol competitive circuit for the Carolinas and Southern Virginia. Earn Shard Points, claim an Infinity Stone, and qualify for the Infinity Gauntlet Championship.' }}">
  <meta property="og:image" content="https://infinitycircuitmcp.com/assets/images/og-preview.png">
  <meta property="og:url" content="https://infinitycircuitmcp.com{{ page.url }}">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="https://infinitycircuitmcp.com/assets/images/og-preview.png">

</head>
<body>

  <!-- ── Navigation ── -->
  <nav class="site-nav">
    <div class="container">
      <a href="/" class="nav-brand">
        <!-- Inline mark SVG — light version for dark nav background -->
        <svg width="36" height="36" viewBox="0 0 56 56" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <!-- Outer hexagon -->
          <polygon points="28,3 51,15.5 51,40.5 28,53 5,40.5 5,15.5"
            fill="none" stroke="#9370c8" stroke-width="2"/>
          <!-- Inner hexagon ring -->
          <polygon points="28,11 44,20.5 44,35.5 28,45 12,35.5 12,20.5"
            fill="none" stroke="#9370c8" stroke-width="1.5" opacity="0.45"/>
          <!-- Center gem -->
          <polygon points="28,19 36,24 36,32 28,37 20,32 20,24"
            fill="#9370c8"/>
          <!-- Stone dots — clockwise from top -->
          <circle cx="28" cy="3"    r="3" fill="#c41e3a"/> <!-- Reality -->
          <circle cx="51" cy="15.5" r="3" fill="#e8b800"/> <!-- Mind -->
          <circle cx="51" cy="40.5" r="3" fill="#e87200"/> <!-- Soul -->
          <circle cx="28" cy="53"   r="3" fill="#1a5fe0"/> <!-- Space -->
          <circle cx="5"  cy="40.5" r="3" fill="#0da85e"/> <!-- Time -->
          <circle cx="5"  cy="15.5" r="3" fill="#c0357a"/> <!-- Power -->
        </svg>
        <span class="nav-brand-text">
          <span class="nav-brand-name">Infinity Circuit</span>
          <span class="nav-brand-sub">Marvel: Crisis Protocol</span>
        </span>
      </a>

      <button class="nav-toggle" aria-label="Toggle navigation" onclick="this.closest('nav').querySelector('.nav-links').classList.toggle('open')">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <ul class="nav-links">
        <li><a href="/standings/" {% if page.url == '/standings/' %}class="active"{% endif %}>Standings</a></li>
        <li><a href="/events/" {% if page.url == '/events/' %}class="active"{% endif %}>Events</a></li>
        <li><a href="/news/" {% if '/news' in page.url %}class="active"{% endif %}>News</a></li>
        <li><a href="/gallery/" {% if page.url == '/gallery/' %}class="active"{% endif %}>Gallery</a></li>
        <li><a href="/rules/" {% if page.url == '/rules/' %}class="active"{% endif %}>Rules</a></li>
        <li><a href="/about/" {% if page.url == '/about/' %}class="active"{% endif %}>About</a></li>
        <li><a href="/submit/" class="btn btn-primary" style="padding: 0.4rem 1rem; font-size:0.8rem;">Submit Results</a></li>
      </ul>
    </div>
  </nav>

  <!-- ── Page Content ── -->
  <main>
    {{ content | safe }}
  </main>

  <!-- ── Footer ── -->
  <footer class="site-footer">
    <div class="container">
      <span>© {{ build.env.npm_package_version or '' }} Infinity Circuit. Not affiliated with Atomic Mass Games or Marvel.</span>
      <ul class="footer-links">
        <li><a href="/rules/">Rules</a></li>
        <li><a href="/submit/">Submit Results</a></li>
        <li><a href="/apply/">Host an Event</a></li>
        <li><a href="https://longshanks.org" target="_blank" rel="noopener">Longshanks</a></li>
        <li><a href="https://atomicmassgames.com/rules" target="_blank" rel="noopener">AMG Rules</a></li>
      </ul>
    </div>
  </footer>

<div id="nl-popup" style="display:none; position:fixed; bottom:1.5rem; right:1.5rem; z-index:200; width:320px; background:#1c1830; border:1px solid rgba(147,112,200,0.3); border-radius:8px; padding:1.5rem; box-shadow:0 8px 32px rgba(0,0,0,0.5);">
  <button onclick="dismissPopup()" style="position:absolute;top:0.75rem;right:0.75rem;background:none;border:none;color:rgba(255,255,255,0.35);font-size:1.25rem;cursor:pointer;line-height:1;">×</button>
  <div style="font-size:0.7rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:var(--void-violet);margin-bottom:0.4rem;">Newsletter</div>
  <div style="font-size:1rem;font-weight:600;color:#fff;margin-bottom:0.4rem;">Stay in the Loop</div>
  <p style="font-size:0.8125rem;color:rgba(255,255,255,0.55);margin-bottom:1rem;line-height:1.5;">Event updates, results, and Championship news delivered to your inbox.</p>
  <form id="nl-popup-form" onsubmit="submitPopup(event)" style="margin:0;">
    <input type="email" id="nl-popup-email" placeholder="your@email.com" required
      style="width:100%;background:rgba(255,255,255,0.06);border:1px solid rgba(147,112,200,0.3);border-radius:4px;color:#fff;font-family:var(--font);font-size:0.8125rem;padding:0.55rem 0.75rem;outline:none;margin-bottom:0.6rem;box-sizing:border-box;">
    <button type="submit" class="btn btn-primary" style="width:100%;font-size:0.8125rem;">Subscribe</button>
  </form>
  <div id="nl-popup-success" style="display:none;font-size:0.875rem;color:#0da85e;text-align:center;padding:0.5rem 0;">You're in. We'll be in touch.</div>
</div>

<script>
(function() {
  var DISMISSED_KEY = 'ic_nl_dismissed';
  var DELAY_MS = 8000;
  var SNOOZE_DAYS = 7;

  function shouldShow() {
    var dismissed = localStorage.getItem(DISMISSED_KEY);
    if (!dismissed) return true;
    var daysAgo = (Date.now() - parseInt(dismissed)) / (1000 * 60 * 60 * 24);
    return daysAgo > SNOOZE_DAYS;
  }

  window.dismissPopup = function() {
    document.getElementById('nl-popup').style.display = 'none';
    localStorage.setItem(DISMISSED_KEY, Date.now().toString());
  };

  window.submitPopup = function(e) {
    e.preventDefault();
    var email = document.getElementById('nl-popup-email').value;
    var formData = new FormData();
    formData.append('fields[email]', email);
    formData.append('ml-submit', '1');
    formData.append('anticsrf', 'true');

    fetch('https://assets.mailerlite.com/jsonp/2395914/forms/189053535392892625/subscribe', {
      method: 'POST',
      body: formData,
      mode: 'no-cors'
    }).then(function() {
      document.getElementById('nl-popup-form').style.display = 'none';
      document.getElementById('nl-popup-success').style.display = 'block';
      setTimeout(function() { dismissPopup(); }, 2500);
    });
  };

if (shouldShow()) {
    document.addEventListener('DOMContentLoaded', function() {
      setTimeout(function() {
        var popup = document.getElementById('nl-popup');
        if (popup) popup.style.display = 'block';
      }, DELAY_MS);
    });
  }
})();
</script>

</body>
</html>
