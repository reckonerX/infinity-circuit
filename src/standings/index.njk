---
layout: layouts/base.njk
title: Standings
description: Infinity Circuit Season Standings — Shard Point leaderboard
---

<section class="hero" style="padding: 3rem 0 2.5rem;">
  <div class="container">
    <h1 class="hero-title" style="font-size: 2rem;">Season Standings</h1>
    <p class="hero-subtitle">Shard Point Leaderboard</p>
  </div>
</section>

<section class="section section-light">
  <div class="container">

    <div id="standings-meta" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:0.75rem;">
      <div id="standings-status" style="font-size:0.8125rem; color:rgba(255,255,255,0.45);">Loading standings...</div>
      <label style="font-size:0.8125rem; color:rgba(255,255,255,0.55); display:flex; align-items:center; gap:0.4rem; cursor:pointer;">
        <input type="checkbox" id="toggle-stone-holders" checked>
        Show Stone holders
      </label>
    </div>

    <div style="overflow-x: auto;">
      <table class="standings-table" id="standings-table">
        <thead>
          <tr>
            <th style="width:48px;">Rank</th>
            <th>Player</th>
            <th style="width:120px; text-align:center;">Stone</th>
            <th style="width:100px; text-align:right;">Shards</th>
            <th style="width:80px; text-align:center;">Events</th>
            <th style="width:160px;">Championship</th>
          </tr>
        </thead>
        <tbody id="standings-body">
          <tr>
            <td colspan="6" style="text-align:center; padding: 3rem; color:rgba(255,255,255,0.4);">
              Loading...
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div id="standings-footer" style="margin-top:1rem; font-size:0.75rem; color:rgba(255,255,255,0.3);"></div>

  </div>
</section>

<style>
.player-name {
  font-weight: 500;
  color: #fff;
}
.player-username {
  font-size: 0.75rem;
  color: rgba(255,255,255,0.45);
  margin-top: 0.1rem;
}
.champ-standing {
  font-size: 0.75rem;
}
.champ-stone {
  font-weight: 500;
}
.gem-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.45rem;
}
.gem-label {
  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.04em;
}
</style>

<script>
(function () {
  var SHEET_ID = '1eFyIt13Av9MmEx0pi0Kca9gxCJJdEs4lnV9slVSJQFE';
  var GID = '2103732828';
  var URL = 'https://docs.google.com/spreadsheets/d/' + SHEET_ID + '/gviz/tq?tqx=out:json&headers=1&gid=' + GID;

  var STONE_COLORS = {
    'Reality': '#c41e3a',
    'Mind':    '#e8b800',
    'Soul':    '#e87200',
    'Space':   '#1a5fe0',
    'Time':    '#0da85e',
    'Power':   '#c0357a'
  };

  function gemSVG(color) {
    // Hexagonal gem shape using brand mark center gem coordinates, scaled up
    var light = lighten(color);
    return '<svg width="20" height="20" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;">'
      + '<polygon points="10,1 17,5 17,14 10,18 3,14 3,5" fill="' + color + '" opacity="0.25"/>'
      + '<polygon points="10,1 17,5 17,14 10,18 3,14 3,5" fill="none" stroke="' + color + '" stroke-width="1.5"/>'
      + '<polygon points="10,5 14,7.5 14,12.5 10,15 6,12.5 6,7.5" fill="' + color + '" opacity="0.6"/>'
      + '<polygon points="10,5 14,7.5 10,5 6,7.5" fill="' + light + '" opacity="0.5"/>'
      + '</svg>';
  }

  function lighten(hex) {
    var r = parseInt(hex.slice(1,3),16);
    var g = parseInt(hex.slice(3,5),16);
    var b = parseInt(hex.slice(5,7),16);
    r = Math.min(255, r + 80);
    g = Math.min(255, g + 80);
    b = Math.min(255, b + 80);
    return '#' + [r,g,b].map(function(v){ return v.toString(16).padStart(2,'0'); }).join('');
  }

  function stoneCell(stone) {
    if (!stone) return '';
    var color = STONE_COLORS[stone] || '#888';
    return '<div class="gem-cell">'
      + gemSVG(color)
      + '<span class="gem-label" style="color:' + color + ';">' + stone + '</span>'
      + '</div>';
  }

  function champStanding(r) {
    if (!r.champStanding) return '';
    if (r.stone) {
      var color = STONE_COLORS[r.stone] || '#888';
      return '<span class="champ-stone" style="color:' + color + ';">Qualified ✓</span>';
    }
    return '<span style="color:var(--void-violet);">' + esc(r.champStanding) + '</span>';
  }

  function esc(str) {
    if (!str) return '';
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function renderRows(rows, showStone) {
    var tbody = document.getElementById('standings-body');
    if (!rows.length) {
      tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:3rem;color:rgba(255,255,255,0.4);">No standings data yet. Check back after the first event.</td></tr>';
      return;
    }

    var html = '';
    rows.forEach(function (r) {
      if (!showStone && r.stone) return;
      html += '<tr>'
        + '<td class="standings-rank">' + esc(r.rank) + '</td>'
        + '<td>'
          + '<div class="player-name">' + esc(r.name) + '</div>'
          + (r.username ? '<div class="player-username">@' + esc(r.username) + '</div>' : '')
        + '</td>'
        + '<td style="text-align:center;">' + stoneCell(r.stone) + '</td>'
        + '<td style="text-align:right; font-weight:600; color:#fff;">' + esc(r.shards || '—') + '</td>'
        + '<td style="text-align:center; color:rgba(255,255,255,0.5);">'
          + esc(r.eventsCounted || '—') + (r.totalEvents ? '/' + esc(r.totalEvents) : '')
        + '</td>'
        + '<td class="champ-standing">' + champStanding(r) + '</td>'
        + '</tr>';
    });
    tbody.innerHTML = html || '<tr><td colspan="6" style="text-align:center;padding:2rem;color:rgba(255,255,255,0.4);">No players match current filter.</td></tr>';
  }

function parseRows(data) {
  var rows = [];
  if (!data || !data.table || !data.table.rows) return rows;
  data.table.rows.forEach(function (row) {
    if (!row.c) return;
    function val(i) {
      return (row.c[i] && row.c[i].v != null) ? String(row.c[i].v).trim() : '';
    }
    var name = val(1);
    if (!name) return;
    rows.push({
      rank:          val(0),
      name:          name,
      username:      val(2),
      stone:         val(3),
      shards:        parseFloat(val(4)) || 0,
      eventsCounted: val(5),
      totalEvents:   val(6),
      champStanding: val(30)
    });
  });

  // Stone holders first, then by Shards descending
  rows.sort(function(a, b) {
    if (a.stone && !b.stone) return -1;
    if (!a.stone && b.stone) return 1;
    return b.shards - a.shards;
  });

  // Re-assign rank after sort
  rows.forEach(function(r, i) { r.rank = i + 1; });

  return rows;
}

  var allRows = [];

  document.getElementById('toggle-stone-holders').addEventListener('change', function () {
    renderRows(allRows, this.checked);
  });

  fetch(URL)
    .then(function (res) { return res.text(); })
    .then(function (text) {
      var json = text.replace(/^[^(]+\(/, '').replace(/\);?\s*$/, '');
      var data = JSON.parse(json);
      allRows = parseRows(data);
      renderRows(allRows, true);

      var status = document.getElementById('standings-status');
      status.textContent = allRows.length + ' player' + (allRows.length !== 1 ? 's' : '') + ' — Season 1';

      var footer = document.getElementById('standings-footer');
      footer.textContent = 'Standings update automatically as events are approved. Best 4 results count toward season total.';
    })
    .catch(function (err) {
      document.getElementById('standings-body').innerHTML =
        '<tr><td colspan="6" style="text-align:center;padding:3rem;color:#c00;">Failed to load standings. Please try again later.</td></tr>';
      document.getElementById('standings-status').textContent = 'Error loading data';
      console.error('Standings fetch error:', err);
    });
})();
</script>
