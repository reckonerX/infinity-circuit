<script>
(function () {
  var BASE = 3, PEAK = 4.8, CYCLE = 8000, HALF = 250;
  var dots = [0,1,2,3,4,5].map(function(i){ return document.getElementById('sd' + i); });

  function pulse(dot) {
    var start = null;
    function step(ts) {
      if (!start) start = ts;
      var e = ts - start;
      var r;
      if (e < HALF) {
        r = BASE + (PEAK - BASE) * (0.5 - 0.5 * Math.cos(Math.PI * e / HALF));
      } else if (e < HALF * 2) {
        r = PEAK - (PEAK - BASE) * (0.5 - 0.5 * Math.cos(Math.PI * (e - HALF) / HALF));
      } else {
        dot.setAttribute('r', BASE);
        return;
      }
      dot.setAttribute('r', r);
      requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  dots.forEach(function (dot, i) {
    if (!dot) return;
    setTimeout(function () {
      pulse(dot);
      setInterval(function () { pulse(dot); }, CYCLE);
    }, i * (CYCLE / dots.length));
  });
})();

// ── Live Events ──
(function () {
  var SHEET_ID = '1eFyIt13Av9MmEx0pi0Kca9gxCJJdEs4lnV9slVSJQFE';
  var GID = '980771470';
  var URL = 'https://docs.google.com/spreadsheets/d/' + SHEET_ID + '/gviz/tq?tqx=out:json&gid=' + GID;

  var STONE_COLORS = {
    'Reality': { hex: '#c41e3a', rgb: '196,30,58'  },
    'Mind':    { hex: '#e8b800', rgb: '232,184,0'  },
    'Soul':    { hex: '#e87200', rgb: '232,114,0'  },
    'Space':   { hex: '#1a5fe0', rgb: '26,95,224'  },
    'Time':    { hex: '#0da85e', rgb: '13,168,94'  },
    'Power':   { hex: '#c0357a', rgb: '192,53,122' }
  };

  function formatDate(v) {
    if (!v) return '';
    var m = String(v).match(/Date\((\d+),(\d+),(\d+)\)/);
    if (m) {
      var d = new Date(parseInt(m[1]), parseInt(m[2]), parseInt(m[3]));
      return d.toLocaleDateString('en-US', { weekday:'short', month:'short', day:'numeric', year:'numeric' });
    }
    return String(v);
  }

  function formatTime(v) {
    if (!v) return '';
    var m = String(v).match(/Date\([\d,]+,(\d+),(\d+),(\d+)\)/);
    if (m) {
      var h = parseInt(m[1]), min = parseInt(m[2]);
      var ampm = h >= 12 ? 'PM' : 'AM';
      h = h % 12 || 12;
      return h + (min ? ':' + String(min).padStart(2,'0') : '') + ' ' + ampm;
    }
    return String(v);
  }

  function esc(str) {
    if (!str) return '';
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  fetch(URL)
    .then(function(res){ return res.text(); })
    .then(function(text){
      var json = text.replace(/^[^(]+\(/, '').replace(/\);?\s*$/, '');
      var data = JSON.parse(json);
      var events = [];
      if (data && data.table && data.table.rows) {
        data.table.rows.forEach(function(row) {
          if (!row.c) return;
          function val(i) {
            if (!row.c[i] || row.c[i].v == null) return '';
            return String(row.c[i].v).trim();
          }
          var status = val(10);
          if (status === 'DRAFT') return;
          var name = val(0);
          if (!name) return;
          events.push({
            name: name,
            date: row.c[1] ? row.c[1].v : '',
            time: row.c[2] ? row.c[2].v : '',
            store: val(3),
            city: val(4),
            tier: val(6),
            stone: val(7),
            longshanks: val(8),
            status: status || 'PUBLISHED'
          });
        });
        events.sort(function(a,b){
          if (!a.date) return 1;
          if (!b.date) return -1;
          return a.date > b.date ? 1 : -1;
        });
      }

      var container = document.getElementById('home-events');
      var upcoming = events.filter(function(e){ return e.status !== 'CANCELLED'; }).slice(0, 3);

      if (!upcoming.length) {
        container.innerHTML = '<p style="color:rgba(255,255,255,0.4);">No upcoming events yet. Check back soon.</p>';
        return;
      }

      container.innerHTML = upcoming.map(function(ev) {
        var isQualifier = ev.tier === 'Infinity Qualifier' && ev.stone && STONE_COLORS[ev.stone];
        var stone = isQualifier ? STONE_COLORS[ev.stone] : null;
        var accent = stone ? stone.hex : 'var(--void-violet)';
        var pillHtml = isQualifier
          ? '<span class="pill" style="color:' + stone.hex + ';border-color:' + stone.hex + ';background:rgba(' + stone.rgb + ',0.12);">' + esc(ev.tier) + '</span>'
          : '<span class="pill pill-shards">' + esc(ev.tier) + '</span>';

        return '<div class="event-card" style="border-left-color:' + accent + ';">'
          + '<div class="event-card-tier" style="margin-bottom:0.5rem;">' + pillHtml + '</div>'
          + '<div class="event-card-name">' + esc(ev.name) + '</div>'
          + '<div class="event-card-meta">'
            + (ev.date ? '<div>' + formatDate(ev.date) + (ev.time ? ' · ' + formatTime(ev.time) : '') + '</div>' : '')
            + (ev.store ? '<div>' + esc(ev.store) + (ev.city ? ', ' + esc(ev.city) : '') + '</div>' : '')
          + '</div>'
          + (ev.longshanks ? '<div style="margin-top:0.75rem;"><a href="' + esc(ev.longshanks) + '" target="_blank" rel="noopener" class="btn btn-primary" style="font-size:0.75rem;padding:0.3rem 0.8rem;' + (stone ? 'background:' + stone.hex + ';' : '') + '">View on Longshanks</a></div>' : '')
          + '</div>';
      }).join('');
    })
    .catch(function() {
      document.getElementById('home-events').innerHTML = '<p style="color:rgba(255,255,255,0.4);">Could not load events.</p>';
    });
})();

// ── Live Standings ──
(function () {
  var SHEET_ID = '1eFyIt13Av9MmEx0pi0Kca9gxCJJdEs4lnV9slVSJQFE';
  var GID = '2103732828';
  var URL = 'https://docs.google.com/spreadsheets/d/' + SHEET_ID + '/gviz/tq?tqx=out:json&gid=' + GID;

  var STONE_COLORS = {
    'Reality': '#c41e3a', 'Mind': '#e8b800', 'Soul': '#e87200',
    'Space': '#1a5fe0', 'Time': '#0da85e', 'Power': '#c0357a'
  };

  function gemSVG(color) {
    var r = Math.min(255, parseInt(color.slice(1,3),16) + 80);
    var g = Math.min(255, parseInt(color.slice(3,5),16) + 80);
    var b = Math.min(255, parseInt(color.slice(5,7),16) + 80);
    var light = '#' + [r,g,b].map(function(v){ return v.toString(16).padStart(2,'0'); }).join('');
    return '<svg width="16" height="16" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;vertical-align:middle;margin-right:4px;">'
      + '<polygon points="10,1 17,5 17,14 10,18 3,14 3,5" fill="' + color + '" opacity="0.3"/>'
      + '<polygon points="10,1 17,5 17,14 10,18 3,14 3,5" fill="none" stroke="' + color + '" stroke-width="1.5"/>'
      + '<polygon points="10,5 14,7.5 14,12.5 10,15 6,12.5 6,7.5" fill="' + color + '" opacity="0.7"/>'
      + '<polygon points="10,5 14,7.5 10,5 6,7.5" fill="' + light + '" opacity="0.5"/>'
      + '</svg>';
  }

  function esc(str) {
    if (!str) return '';
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  fetch(URL)
    .then(function(res){ return res.text(); })
    .then(function(text){
      var json = text.replace(/^[^(]+\(/, '').replace(/\);?\s*$/, '');
      var data = JSON.parse(json);
      var rows = [];
if (data && data.table && data.table.rows) {
  data.table.rows.forEach(function(row) {
    if (!row.c) return;
    function val(i) {
      return (row.c[i] && row.c[i].v != null) ? String(row.c[i].v).trim() : '';
    }
    var name = val(1);
    if (!name) return;
    rows.push({ rank: val(0), name: name, username: val(2), stone: val(3), shards: parseFloat(val(4)) || 0 });
  });
}

// Stone holders first, then by Shards descending
rows.sort(function(a, b) {
  if (a.stone && !b.stone) return -1;
  if (!a.stone && b.stone) return 1;
  return b.shards - a.shards;
});

// Re-assign rank after sort
rows.forEach(function(r, i) { r.displayRank = i + 1; });

      var tbody = document.getElementById('home-standings-body');
      if (!rows.length) {
        tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:2rem;color:rgba(255,255,255,0.4);">No standings yet. Check back after the first event.</td></tr>';
        return;
      }

      tbody.innerHTML = rows.slice(0, 6).map(function(r) {
        var stoneColor = r.stone ? STONE_COLORS[r.stone] : null;
        var stoneCell = stoneColor
          ? gemSVG(stoneColor) + '<span style="font-size:0.7rem;color:' + stoneColor + ';font-weight:500;">' + esc(r.stone) + '</span>'
          : '';
        return '<tr>'
          + '<td class="standings-rank">' + r.displayRank + '</td>'
          + '<td><div style="font-weight:500;color:#fff;">' + esc(r.name) + '</div>'
            + (r.username ? '<div style="font-size:0.75rem;color:rgba(255,255,255,0.4);">@' + esc(r.username) + '</div>' : '')
          + '</td>'
          + '<td style="text-align:center;">' + stoneCell + '</td>'
          + '<td style="text-align:right;font-weight:600;color:#fff;">' + esc(r.shards || '—') + '</td>'
          + '</tr>';
      }).join('');
    })
    .catch(function() {
      document.getElementById('home-standings-body').innerHTML = '<tr><td colspan="4" style="text-align:center;padding:2rem;color:rgba(255,255,255,0.4);">Could not load standings.</td></tr>';
    });
})();
</script>
