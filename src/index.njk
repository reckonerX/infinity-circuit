<script>
(function () {
  var BASE = 3, PEAK = 4.8, CYCLE = 8000, HALF = 250;
  var dots = [0,1,2,3,4,5].map(function(i){ return document.getElementById('sd' + i); });

  function pulse(dot) {
    var start = null;
    function step(ts) {
      if (!start) start = ts;
      var e = ts - start;
      var r;
      if (e < HALF) {
        r = BASE + (PEAK - BASE) * (0.5 - 0.5 * Math.cos(Math.PI * e / HALF));
      } else if (e < HALF * 2) {
        r = PEAK - (PEAK - BASE) * (0.5 - 0.5 * Math.cos(Math.PI * (e - HALF) / HALF));
      } else {
        dot.setAttribute('r', BASE);
        return;
      }
      dot.setAttribute('r', r);
      requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  dots.forEach(function (dot, i) {
    if (!dot) return;
    setTimeout(function () {
      pulse(dot);
      setInterval(function () { pulse(dot); }, CYCLE);
    }, i * (CYCLE / dots.length));
  });
})();
</script>
