---
layout: layouts/base.njk
title: News
description: Infinity Circuit news and announcements
---

<section class="hero" style="padding: 3rem 0 2.5rem;">
  <div class="container">
    <h1 class="hero-title" style="font-size: 2rem;">News & Announcements</h1>
    <p class="hero-subtitle">Infinity Circuit Updates</p>
  </div>
</section>

<section class="section section-light">
  <div class="container" style="max-width: 860px;">

    {% set postList = collections.posts | reverse %}

    {% if postList.length %}
      <div class="news-grid">
        {% for post in postList %}
        <article class="news-card">
          {% if post.data.heroImage %}
          <a href="{{ post.url }}" class="news-card-image">
            <img src="{{ post.data.heroImage }}" alt="{{ post.data.title }}">
          </a>
          {% endif %}
          <div class="news-card-body">
            <div class="news-card-date">{{ post.date | dateDisplay }}</div>
            <h2 class="news-card-title">
              <a href="{{ post.url }}">{{ post.data.title }}</a>
            </h2>
            {% if post.data.description %}
            <p class="news-card-excerpt">{{ post.data.description }}</p>
            {% endif %}
            <a href="{{ post.url }}" class="news-read-more">Read more →</a>
          </div>
        </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="news-empty">
        <p>No announcements yet. Check back after the first event.</p>
      </div>
    {% endif %}

  </div>
</section>

<style>
.news-grid {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
.news-card {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(147,112,200,0.2);
  border-radius: 6px;
  overflow: hidden;
  display: grid;
  grid-template-columns: 1fr;
  transition: border-color 0.15s, box-shadow 0.15s;
}
.news-card:hover {
  border-color: rgba(147,112,200,0.4);
  box-shadow: 0 4px 24px rgba(0,0,0,0.3);
}
.news-card-image {
  display: block;
  max-height: 280px;
  overflow: hidden;
}
.news-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.2s;
}
.news-card:hover .news-card-image img {
  transform: scale(1.02);
}
.news-card-body {
  padding: 1.5rem;
}
.news-card-date {
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--void-violet);
  margin-bottom: 0.5rem;
}
.news-card-title {
  font-size: 1.25rem;
  font-weight: 600;
  line-height: 1.3;
  margin-bottom: 0.6rem;
}
.news-card-title a {
  color: #fff;
  text-decoration: none;
}
.news-card-title a:hover {
  color: var(--void-violet);
}
.news-card-excerpt {
  font-size: 0.9rem;
  color: rgba(255,255,255,0.55);
  line-height: 1.65;
  margin-bottom: 1rem;
}
.news-read-more {
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--void-violet);
  text-decoration: none;
  letter-spacing: 0.02em;
}
.news-read-more:hover {
  color: #fff;
  text-decoration: none;
}
.news-empty {
  text-align: center;
  padding: 4rem 0;
  color: rgba(255,255,255,0.4);
  font-size: 0.9375rem;
}
</style>
