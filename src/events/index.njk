---
layout: layouts/base.njk
title: Events
description: Infinity Circuit — Upcoming sanctioned events calendar
---

<section class="hero" style="padding: 3rem 0 2.5rem;">
  <div class="container">
    <h1 class="hero-title" style="font-size: 2rem;">Events Calendar</h1>
    <p class="hero-subtitle">Sanctioned Infinity Circuit Events</p>
  </div>
</section>

<section class="section section-light">
  <div class="container">

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:0.75rem;">
      <div id="events-status" style="font-size:0.8125rem; color:rgba(255,255,255,0.45);">Loading events...</div>
      <div style="display:flex; gap:0.5rem; flex-wrap:wrap;" id="tier-filters">
        <button class="filter-btn active" data-tier="all">All</button>
        <button class="filter-btn" data-tier="Shards Event">Shards Events</button>
        <button class="filter-btn" data-tier="Infinity Qualifier">Infinity Qualifiers</button>
        <button class="filter-btn" data-tier="Infinity Gauntlet Championship">Championship</button>
      </div>
    </div>

    <div id="events-grid" class="event-grid">
      <div style="color:rgba(255,255,255,0.4); padding:3rem 0;">Loading...</div>
    </div>

    <div id="events-empty" style="display:none; text-align:center; padding:4rem 0; color:rgba(255,255,255,0.4);">
      No events found for this filter.
    </div>

  </div>
</section>

<section class="section section-tint">
  <div class="container" style="text-align:center;">
    <span class="section-eyebrow">Tournament Organizers</span>
    <h2 class="section-title" style="margin-bottom:1rem;">Want to host an event?</h2>
    <p style="color:rgba(255,255,255,0.55); max-width:520px; margin:0 auto 1.5rem;">
      Any sanctioned store can apply to host a Shards Event. Applications must be submitted
      at least 30 days before the event date.
    </p>
    <a href="/apply/" class="btn btn-primary">Apply to Host</a>
  </div>
</section>

<style>
.filter-btn {
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(147,112,200,0.25);
  color: rgba(255,255,255,0.55);
  font-family: var(--font);
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.04em;
  padding: 0.35rem 0.85rem;
  border-radius: 3px;
  cursor: pointer;
  transition: all 0.15s;
}
.filter-btn:hover {
  border-color: var(--void-violet);
  color: rgba(255,255,255,0.85);
}
.filter-btn.active {
  background: var(--void-violet);
  border-color: var(--void-violet);
  color: #fff;
}

/* Base event card */
.event-card {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(147,112,200,0.2);
  border-radius: 6px;
  padding: 1.25rem;
  position: relative;
  overflow: hidden;
  transition: box-shadow 0.15s, border-color 0.15s;
  border-left-width: 4px;
}
.event-card:hover {
  box-shadow: 0 4px 24px rgba(0,0,0,0.3);
}

/* Stone Qualifier card — full stone theme */
.event-card.card-qualifier {
  border-color: var(--stone-color);
  background: linear-gradient(135deg, rgba(var(--stone-rgb),0.12) 0%, rgba(255,255,255,0.03) 100%);
}
.event-card.card-qualifier:hover {
  box-shadow: 0 4px 32px rgba(var(--stone-rgb), 0.25);
}

.event-card-tier {
  margin-bottom: 0.6rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.event-card-name {
  font-size: 1rem;
  font-weight: 600;
  color: #fff;
  line-height: 1.3;
  margin-bottom: 0.5rem;
}
.event-card-meta {
  font-size: 0.8125rem;
  color: rgba(255,255,255,0.5);
  line-height: 1.6;
}
.event-card-meta strong {
  color: rgba(255,255,255,0.85);
  font-weight: 500;
}
.event-card-actions {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid rgba(255,255,255,0.08);
  display: flex;
  gap: 0.75rem;
  align-items: center;
  flex-wrap: wrap;
}
.event-card-capacity {
  font-size: 0.75rem;
  color: rgba(255,255,255,0.4);
  margin-left: auto;
}
.btn-sm {
  font-size: 0.75rem;
  padding: 0.35rem 0.85rem;
}
.btn-stone {
  color: #fff;
  border: none;
}
.cancelled-banner {
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #c41e3a;
  border: 1px solid #c41e3a;
  border-radius: 3px;
  padding: 0.15rem 0.5rem;
}
.stone-label {
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
}
</style>

<script>
(function () {
  var SHEET_ID = '1eFyIt13Av9MmEx0pi0Kca9gxCJJdEs4lnV9slVSJQFE';
  var GID = '980771470';
  var URL = 'https://docs.google.com/spreadsheets/d/' + SHEET_ID + '/gviz/tq?tqx=out:json&gid=' + GID;

  var STONE_COLORS = {
    'Reality': { hex: '#c41e3a', rgb: '196,30,58'  },
    'Mind':    { hex: '#e8b800', rgb: '232,184,0'  },
    'Soul':    { hex: '#e87200', rgb: '232,114,0'  },
    'Space':   { hex: '#1a5fe0', rgb: '26,95,224'  },
    'Time':    { hex: '#0da85e', rgb: '13,168,94'  },
    'Power':   { hex: '#c0357a', rgb: '192,53,122' }
  };

  function gemSVG(color) {
    var light = lighten(color);
    return '<svg width="16" height="16" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;">'
      + '<polygon points="10,1 17,5 17,14 10,18 3,14 3,5" fill="' + color + '" opacity="0.3"/>'
      + '<polygon points="10,1 17,5 17,14 10,18 3,14 3,5" fill="none" stroke="' + color + '" stroke-width="1.5"/>'
      + '<polygon points="10,5 14,7.5 14,12.5 10,15 6,12.5 6,7.5" fill="' + color + '" opacity="0.7"/>'
      + '<polygon points="10,5 14,7.5 10,5 6,7.5" fill="' + light + '" opacity="0.5"/>'
      + '</svg>';
  }

  function lighten(hex) {
    var r = Math.min(255, parseInt(hex.slice(1,3),16) + 80);
    var g = Math.min(255, parseInt(hex.slice(3,5),16) + 80);
    var b = Math.min(255, parseInt(hex.slice(5,7),16) + 80);
    return '#' + [r,g,b].map(function(v){ return v.toString(16).padStart(2,'0'); }).join('');
  }

  function formatDate(v) {
    if (!v) return '';
    var m = String(v).match(/Date\((\d+),(\d+),(\d+)\)/);
    if (m) {
      var d = new Date(parseInt(m[1]), parseInt(m[2]), parseInt(m[3]));
      return d.toLocaleDateString('en-US', { weekday:'short', year:'numeric', month:'long', day:'numeric' });
    }
    return String(v);
  }

  function formatTime(v) {
    if (!v) return '';
    var m = String(v).match(/Date\([\d,]+,(\d+),(\d+),(\d+)\)/);
    if (m) {
      var h = parseInt(m[1]);
      var min = parseInt(m[2]);
      var ampm = h >= 12 ? 'PM' : 'AM';
      h = h % 12 || 12;
      return h + (min ? ':' + String(min).padStart(2,'0') : '') + ' ' + ampm;
    }
    return String(v);
  }

  function esc(str) {
    if (!str) return '';
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function renderCard(ev) {
    var isQualifier = ev.tier === 'Infinity Qualifier' && ev.stone && STONE_COLORS[ev.stone];
    var stone = isQualifier ? STONE_COLORS[ev.stone] : null;
    var cancelled = ev.status === 'CANCELLED';

    var cardStyle = isQualifier
      ? ' style="--stone-color:' + stone.hex + '; --stone-rgb:' + stone.rgb + '; border-left-color:' + stone.hex + ';"'
      : ' style="border-left-color: var(--void-violet);"';

    var cardClass = 'event-card' + (isQualifier ? ' card-qualifier' : '');

    // Pill
    var pill = '';
    if (isQualifier) {
      pill = '<span class="pill" style="color:' + stone.hex + '; border-color:' + stone.hex + '; background:rgba(' + stone.rgb + ',0.12);">'
        + esc(ev.tier) + '</span>'
        + '<span class="stone-label" style="color:' + stone.hex + ';">'
        + gemSVG(stone.hex) + esc(ev.stone) + ' Stone</span>';
    } else if (ev.tier === 'Infinity Gauntlet Championship') {
      pill = '<span class="pill pill-championship">' + esc(ev.tier) + '</span>';
    } else {
      pill = '<span class="pill pill-shards">' + esc(ev.tier) + '</span>';
    }

    // Button
    var lsUrl = ev.longshanks;
      if (lsUrl && !lsUrl.match(/^https?:\/\//)) {
        lsUrl = 'https://' + lsUrl;
      }
    var btn = '';
    if (ev.longshanks && !cancelled) {
      if (isQualifier) {
        btn = '<a href="' + esc(lsUrl) + '" target="_blank" rel="noopener" class="btn btn-stone btn-sm" style="background:' + stone.hex + ';">View on Longshanks</a>';
      } else {
        btn = '<a href="' + esc(lsUrl) + '" target="_blank" rel="noopener" class="btn btn-primary btn-sm">View on Longshanks</a>';
      }
    }

    return '<div class="' + cardClass + '"' + cardStyle + '>'
      + '<div class="event-card-tier">'
        + pill
        + (cancelled ? '<span class="cancelled-banner">Cancelled</span>' : '')
      + '</div>'
      + '<div class="event-card-name">' + esc(ev.name) + '</div>'
      + '<div class="event-card-meta">'
        + (ev.date ? '<div><strong>' + formatDate(ev.date) + '</strong>' + (ev.time ? ' · ' + formatTime(ev.time) : '') + '</div>' : '')
        + (ev.store   ? '<div>' + esc(ev.store)   + '</div>' : '')
        + (ev.city    ? '<div>' + esc(ev.city)     + '</div>' : '')
        + (ev.address ? '<div>' + esc(ev.address)  + '</div>' : '')
      + '</div>'
      + '<div class="event-card-actions">'
        + btn
        + (ev.capacity ? '<span class="event-card-capacity">' + esc(ev.capacity) + ' players</span>' : '')
      + '</div>'
      + '</div>';
  }

  function renderGrid(events) {
    var grid = document.getElementById('events-grid');
    var empty = document.getElementById('events-empty');
    if (!events.length) {
      grid.innerHTML = '';
      empty.style.display = 'block';
      return;
    }
    empty.style.display = 'none';
    grid.innerHTML = events.map(renderCard).join('');
  }

  function parseEvents(data) {
    var events = [];
    if (!data || !data.table || !data.table.rows) return events;
    data.table.rows.forEach(function (row) {
      if (!row.c) return;
      function val(i) {
        if (!row.c[i] || row.c[i].v == null) return '';
        return String(row.c[i].v).trim();
      }
      var status = val(10);
      if (status === 'DRAFT') return;
      var name = val(0);
      if (!name) return;
      events.push({
        name:       name,
        date:       row.c[1] ? row.c[1].v : '',
        time:       row.c[2] ? row.c[2].v : '',
        store:      val(3),
        city:       val(4),
        address:    val(5),
        tier:       val(6),
        stone:      val(7),
        longshanks: val(8),
        capacity:   val(9),
        status:     status || 'PUBLISHED'
      });
    });
    events.sort(function(a,b){
      if (!a.date) return 1;
      if (!b.date) return -1;
      return a.date > b.date ? 1 : -1;
    });
    return events;
  }

  var allEvents = [];

  document.getElementById('tier-filters').addEventListener('click', function (e) {
    var btn = e.target.closest('.filter-btn');
    if (!btn) return;
    var tier = btn.dataset.tier;
    document.querySelectorAll('.filter-btn').forEach(function(b){ b.classList.remove('active'); });
    btn.classList.add('active');
    var filtered = tier === 'all' ? allEvents : allEvents.filter(function(ev){ return ev.tier === tier; });
    renderGrid(filtered);
  });

  fetch(URL)
    .then(function(res){ return res.text(); })
    .then(function(text){
      var json = text.replace(/^[^(]+\(/, '').replace(/\);?\s*$/, '');
      var data = JSON.parse(json);
      allEvents = parseEvents(data);
      renderGrid(allEvents);
      var published = allEvents.filter(function(e){ return e.status !== 'CANCELLED'; }).length;
      document.getElementById('events-status').textContent = published + ' upcoming event' + (published !== 1 ? 's' : '');
    })
    .catch(function(err){
      document.getElementById('events-grid').innerHTML = '<div style="color:#c41e3a; padding:2rem 0;">Failed to load events. Please try again later.</div>';
      document.getElementById('events-status').textContent = 'Error loading data';
      console.error('Events fetch error:', err);
    });
})();
</script>
